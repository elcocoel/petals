# Petal environment. Every variable is optional; leave a value empty to use the default.
# Never put a key in this file or anywhere in the repo: keys live in ../.secrets/, outside it.
# Shapes and defaults: specs/001-petal-core/quickstart.md and contracts/.

# NEAR AI Cloud key for Petal's agent. Unset: the agent replays a recorded run and says so.
NEAR_AI_API_KEY=
# The model asked first (default deepseek-ai/DeepSeek-V4.1-Flash-1017). A canonical id from NEAR AI's
# GET /v1/models. /make shows which model answered and whether it signed. Only models with enclave
# attestation get a provider_tee signature. Dearer models hit the $0.05 chat budget sooner.
PETAL_MODEL=
# Daily spend cap for the one server inference key, in USD (default 3).
PETAL_LLM_DAILY_USD=

# The shared map on FastData KV. Testnet only during the build.
# Network (default testnet), receiver (petals.testnet), Petal's writer (petals-writer.testnet).
PETAL_MAP_NETWORK=
PETAL_MAP_RECEIVER=
PETAL_WRITER_ACCOUNT=
# Path to the writer's function-call key file, outside the repo (e.g. ../.secrets/petal-writer.testnet.json).
PETAL_WRITER_KEY_FILE=
# Comma-separated writers whose map rows the gallery shows (default petals-writer.testnet).
PETAL_TRUSTED_WRITERS=

# Optional FastNEAR key; sent only when set.
FASTNEAR_API_KEY=

# NEAR account that would receive a payment quote (dry quotes only; FR-031).
PETAL_PAYOUT_ACCOUNT=

# Base URL of Petal's HTTP API for the skill, the CLI and the web app (default http://localhost:8787).
PETAL_API=
# 1 = the web app reads fixtures through a mock of the API routes (before W4 and W5 land).
PETAL_API_MOCK=
# 1 = pnpm test:e2e runs live: NEAR AI Cloud, testnet map, live 1Click dry quote. Needs the keys above.
PETAL_LIVE=
# The public repo, for correction-request issue links (GitHub fallback, FR-022).
PETAL_REPO_URL=

# 1: fakes everywhere: fake map, recorded agent, recorded quote, no RPC. Every door reads it.
PETAL_FAKE=
# 1 to show /lab in production (scripts/serve-testnet.sh sets it). Always on under `next dev`.
PETAL_LAB=
