# Petal environment. Every variable is optional; leave a value empty to use the default.
# Never put a key in this file or anywhere in the repo: keys live in ../.secrets/, outside it.
# Shapes and defaults: specs/001-petal-core/quickstart.md and contracts/.

# NEAR AI Cloud key for Petal's agent. Unset: the agent replays a recorded run and says so.
NEAR_AI_API_KEY=
# The model asked first (default deepseek-ai/DeepSeek-V4.1-Flash-1017). A canonical id from NEAR AI's
# GET /v1/models. /make shows which model answered and whether it signed. Only models with enclave
# attestation get a provider_tee signature. Dearer models hit the $0.05 chat budget sooner.
PETAL_MODEL=
# Daily spend cap for the one server inference key, in USD (default 3).
PETAL_LLM_DAILY_USD=
# Who may use Petal's own agent on a real model. gated (the default): only a session holding a
# sponsored invite (scripts/mint-invite.ts). open: anyone who reaches the server, for your own local
# tool. The recorded demo, viewing and all tools need neither.
PETAL_AGENT_ACCESS=
# Seals wallet addresses at rest: `openssl rand -hex 32`. Keep it outside the repo. Required when
# gated with a model key: the server won't start without it. Elsewhere, a throwaway key per process.
PETAL_WALLET_KEY=
# Seconds one chat may run; default 300. The per-chat dollar cap applies either way.
PETAL_RUN_MAX_S=

# The shared map on FastData KV. Testnet only during the build.
# Network (default testnet), receiver (petals.testnet), Petal's writer (petals-writer.testnet).
PETAL_MAP_NETWORK=
PETAL_MAP_RECEIVER=
PETAL_WRITER_ACCOUNT=
# Path to the writer's function-call key file, outside the repo (e.g. ../.secrets/petal-writer.testnet.json).
PETAL_WRITER_KEY_FILE=
# Comma-separated writers whose map rows the gallery shows (default petals-writer.testnet).
PETAL_TRUSTED_WRITERS=

# Optional FastNEAR key; sent only when set.
FASTNEAR_API_KEY=

# NEAR account that would receive a payment quote (dry quotes only; FR-031).
PETAL_PAYOUT_ACCOUNT=

# Base URL of Petal's HTTP API for the skill, the CLI and the web app (default http://localhost:8787).
# Also the site's public address for sign-in: the recipient a wallet shows, the allowed Origin, and
# the cookie's name (__Host-petal_session on https://, petal_session on http://). Set it before going
# public, or a wallet would sign for "localhost" and browsers would be refused.
PETAL_API=
# 1: a public site. It reads no chain or web page, searches nothing, runs no model and writes no chain
# for anyone: each person's own agent does that on their machine and posts what it made. The container
# sets it whenever Petals/public-url exists. Health then says agent_access none.
PETAL_PUBLIC=
# Where private data lives. postgres://<role>@<host>:<port>/<db> for Postgres, the password in the file
# PETAL_DATABASE_PASSWORD_FILE names (never in the address). Unset: SQLite in the state folder, the
# starting point a migration copies from (scripts/db-copy.ts). The server's role only reads and writes
# rows; scripts/db-migrate.ts migrates as the owner role.
PETAL_DATABASE_URL=
PETAL_DATABASE_PASSWORD_FILE=
# Postgres time limits, in milliseconds, and the pool: a statement (default 10000), waiting for a
# connection (5000), a transaction left open doing nothing (15000), and connections (10).
PETAL_DB_STATEMENT_MS=
PETAL_DB_CONNECT_MS=
PETAL_DB_IDLE_TX_MS=
PETAL_DB_POOL=
# 1 = the web app reads fixtures through a mock of the API routes (before W4 and W5 land).
PETAL_API_MOCK=
# 1 = pnpm test:e2e runs live: NEAR AI Cloud, testnet map, live 1Click dry quote. Needs the keys above.
PETAL_LIVE=
# The public repo, for correction-request issue links (GitHub fallback, FR-022).
PETAL_REPO_URL=

# Limits a stranger can meet (T300). Every one refuses in the API, in plain words, with a typed code.
# Past a daily cap: rate_limited, until midnight UTC. Global, kept in private.db, so no address can
# spoof past one and a restart can't reset one. Leave empty for the default.
#
# The data folder. Past this many MB (default 2048), writes a stranger can cause answer budget_exhausted:
# drafts, explorations, steps, notes, links, new wallets, fresh reads, a chat nobody sponsors. It counts
# every file in the state folder, fresh snapshots too, less what SQLite will reuse. Reading and drawing
# stored data go on. Checked on write, no timers; the size is believed for PETAL_DATA_CHECK_S (default 10).
PETAL_DATA_MAX_MB=
PETAL_DATA_CHECK_S=
# Explorations a day with nobody signed in, plus forks by anyone (default 100). A fork copies its rows.
PETAL_EXPLORATIONS_PER_DAY=
# Days an exploration nobody owns stays after its last write (default 14); gone on a later start.
PETAL_UNCLAIMED_DAYS=
# New spec bodies a door may store a day (default 1000, 64 KiB each at most). Past it a drawing has no
# short link, and save_step is refused. The site's own run isn't counted.
PETAL_SPEC_BODIES_PER_DAY=
# Fresh reads use this machine's connection and home address. At one time, per set of callers: the HTTP
# and MCP doors share one set, the agent's runs have another (default 2). Past it: rate_limited at once.
PETAL_FRESH_AT_ONCE=
# Seconds a fresh read may take at a door or in a run (default 90). Past it: source_failed.
PETAL_FRESH_MAX_S=
# Fresh reads a day through the doors (default 20), and by the agent's runs (default 100).
PETAL_FRESH_PER_DAY=
PETAL_FRESH_RUN_PER_DAY=
# read_page and search use this machine's connection too: pages a day (default 500), and searches a day
# on an unofficial route that can refuse this machine (default 100). Past it: rate_limited.
PETAL_PAGE_READS_PER_DAY=
PETAL_SEARCHES_PER_DAY=
# Readings people's own agents post, made on their machines: new ones a day (default 200).
PETAL_POSTED_SNAPSHOTS_PER_DAY=
# What Petal's writer may spend a day, on a 1 NEAR allowance charged at about 0.0014 NEAR a write:
# publishes (default 20) and snapshot fingerprints (default 20). A fingerprint past its cap is skipped,
# and the read still answers.
PETAL_PUBLISHES_PER_DAY=
PETAL_FINGERPRINTS_PER_DAY=
#
# Fixed, named where they apply:
#   BODY_MAX_BYTES 256 KiB        any request body (packages/tools/src/http/reply.ts)
#   CHAT_BODY_MAX_BYTES 512 KiB   the one exception, a chat: the site sends its conversation back
#   16 KiB                        sign-in and invite bodies (packages/agent/src/auth-routes.ts)
#   60 tool calls a minute, 10 chats and 60 follow-ups an hour, 30 auth POSTs a minute: per address,
#     cf-connecting-ip, else the socket on a local site. x-forwarded-for never counts.
#   MAX_TRACKED_KEYS 10,000       addresses a limiter remembers; the oldest is forgotten
#   STEPS_MAX, NOTES_MAX 100      each, per exploration (packages/tools/src/tools/explorations.ts)
#   UNCLAIMED_DELETED_AT_ONCE 50  old explorations one new one clears away
#   MAX_SPEC_BYTES 64 KiB         a stored spec body
#   MAP_LIMITS.valueBytes 256 KiB a prepared entry, checked before it's kept
#   MAX_BUDGET 200,000            edges a power_path may read: about 65 ms holding the event loop
#   MAX_TOOL_CALLS_PER_ROUND 8    in Petal's own agent; the rest are answered, and not run
#   DEFAULT_INVITE_DAYS 14        an invite minted without days

# 1: fakes everywhere: fake map, recorded agent, recorded quote, no RPC. Every door reads it.
PETAL_FAKE=
# 1 to show /lab in production (scripts/serve-testnet.sh sets it). Always on under `next dev`.
PETAL_LAB=
# Test only: where the web app's NEAR AI client sends its calls, for the stub in
# tests/e2e/journey-server.ts. The key goes there too, so never set it on a real host;
# scripts/container/entry.sh unsets it.
PETAL_NEAR_AI_BASE_URL=
