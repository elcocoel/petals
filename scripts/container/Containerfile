# The server as one container (specs/002-system/research.md, C3): the API, /mcp, /skill.md, /petal.mjs,
# /d and /s, and no pages, which the website on Vercel shows. Built from a clean `git archive` of a
# commit, so nothing local (.petal, secrets) can travel in. Node runs the workspace's TypeScript sources directly, so the image keeps
# the workspace layout. Environment and mounts are set at run time, outside the repo.

FROM docker.io/library/node:24.14.0-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1 CI=true
WORKDIR /app
COPY . .
RUN corepack enable pnpm && pnpm install --frozen-lockfile
# The one file a person's agent fetches (apps/cli/scripts/bundle.ts), served by the server.
RUN node apps/cli/scripts/bundle.ts && test -f apps/cli/dist/petal.mjs
# Build tools aren't needed to serve.
RUN pnpm install --frozen-lockfile --prod

FROM docker.io/library/node:24.14.0-bookworm-slim
ARG PETAL_COMMIT=unknown
ENV NODE_ENV=production PETAL_COMMIT=$PETAL_COMMIT PORT=3090 PETAL_STATE_DIR=/data
COPY --from=build /app /app
RUN mkdir -p /data /secrets && chown node:node /data
USER node
WORKDIR /app
EXPOSE 3090
ENTRYPOINT ["/bin/bash", "/app/scripts/container/entry.sh"]
