{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/package.json",
      "!specs",
      "!.specify",
      "!.claude",
      "!fixtures",
      "!packages/core/schema",
      "!packages/core/src/types/generated",
      "!**/*.generated.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "markdown": { "formatter": { "formatEmbeds": false } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "error", "useExportType": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/core/src/**"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "error" } } }
    }
  ]
}
