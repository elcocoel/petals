          "arguments": {
            "spec": {
              "$from": "call_f6458f91a4dc47b59fafbece.spec_sha256"
            },
            "interpretation": {
              "summary": "Power in NEAR's House of Stake is veNEAR voting power: the value of locked NEAR, adjusted for delegations in and out, as defined by the contract and interim constitution. It is extremely concentrated: 519 accounts hold it, but the top 10 hold ~81% and the top 5 the Nakamoto coefficient reaches 5 at the 50% threshold. The two largest holders are anonymous addresses, so the most powerful hands are unattributed.",
              "power_means": [
                {
                  "claim": "Voting power is each account's veNEAR (own locked NEAR, grown to the block time, minus outgoing delegations plus incoming), per the contract rule and interim constitution.",
                  "sources": [
                    "venear-accounts",
                    "hos-source",
                    "hos-constitution",
                    "hos-config"
                  ],
                  "figures": [
                    "fig:total",
                    "fig:nakamoto",
                    "fig:hhi",
                    "fig:gini",
                    "fig:top_k_share.5",
                    "fig:top_k_share.10"
                  ]
                }
              ],
              "mappings": [
                {
                  "primitive": "width",
                  "why": "each petal's width shows the account's share of veNEAR voting power, compressed into a band so the giant top holders stay legible",
                  "sources": [
                    "venear-accounts",
                    "hos-source"
                  ]
                },
                {
                  "primitive": "height",
                  "why": "bar height is the square root of the account's share of voting power, so large and small holders are both visible at a glance",
                  "sources": [
                    "venear-accounts",
                    "hos-source"
                  ]
                },
                {
                  "primitive": "colour",
                  "why": "colours mark the kind of account (DAO, lockup, treasury, or unknown) read from the account id and config",
                  "sources": [
                    "account-id",
                    "hos-config"
                  ]
                },
                {
                  "primitive": "outline",
                  "why": "a solid outline marks a self-declared name; no outline marks an unknown (e.g. a bare hash) identity",
                  "sources": [
                    "account-id"
                  ]
                },
                {
                  "primitive": "order",
                  "why": "petals are ordered most-voting-power-first clockwise from the top, so power reads left-to-right around the flower",
                  "sources": [
                    "venear-accounts"
                  ]
                }
              ],
              "conflicts": [
                "Drafting power: proposals_made records who puts proposals to vote, which is a different measure of influence than balance (not drawn).",
                "Delegated influence: delegated_in_venear captures how much power others hand you; the flower draws the net voting_power each account exercises, not the delegations behind it (no backers segment exists for this network)."
              ],
              "unknowns": [
                "Which real person or organisation controls the two largest anonymous hash addresses (cc96f558…, 4783b548…); the snapshot only has the account id, and a self-declared name stays self-declared.",
                "Per-voter votes were not read (Noted as slow), so how each holder actually voted on proposals is not shown.",
                "Each holder's underlying lockup contract and staking, and off-chain delegate profiles, were not read.",
                "Whether large anonymous holders are coordinated (common control) — fusion markings are not built yet, so no common-control claim is drawn."
              ],
              "inferred": [
                "With 405 accounts holding only ~0.014% of voting power, the long tail is effectively negligible in any single vote (inference from fig:tail)."
              ],
              "documents": []
            }
          }
        }
      ],
