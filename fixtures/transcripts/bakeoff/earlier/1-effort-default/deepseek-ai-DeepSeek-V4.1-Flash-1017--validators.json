            "spec": "e39996053b39dc32bf52de8769a8cc25efe41df4f4cefb04f2d0d15349a737bf",
            "interpretation": {
              "summary": "Each petal is a NEAR validator or staking pool, sized by its share of the 593,372,642.814 NEAR staked in the current epoch, and its side is split into who stands behind it: other delegators, accounts holding 1M+ NEAR, liquid-staking contracts and lockups. Power here means delegated stake: the top 10 pools hold 36.25% of the epoch's stake and 9 pools together pass a third.",
              "power_means": [
                {
                  "claim": "Power in NEAR validation is delegated stake: 9 of 371 validators together hold more than a third of the 593,372,642.814 NEAR staked this epoch, and the 311 smallest hold 13.8%.",
                  "sources": [
                    "fastnear-rpc-validators"
                  ],
                  "figures": [
                    "fig:total",
                    "fig:participants_included",
                    "fig:nakamoto",
                    "fig:top_k_share.10",
                    "fig:tail"
                  ]
                },
                {
                  "claim": "Behind the pools sit delegators: 5,819,27,623 NEAR of roughly 594.48M delegated NEAR was included in the backer split after folding sub-1,000 NEAR delegations into per-pool groups.",
                  "sources": [
                    "fastnear-rpc-staking-pool-views",
                    "fastnear-rpc-liquid-staking"
                  ]
                }
              ],
              "mappings": [
                {
                  "primitive": "width",
                  "why": "Validator's share of this epoch's stake, compressed into a band, so the largest petals stay comparable.",
                  "sources": [
                    "fastnear-rpc-validators"
                  ]
                },
                {
                  "primitive": "height",
                  "why": "Square root of the validator's share, so mid-sized pools are still readable next to the leaders.",
                  "sources": [
                    "fastnear-rpc-validators"
                  ]
                },
                {
                  "primitive": "segments",
                  "why": "The side of each petal is split by backer class: other delegators, 1M+ NEAR accounts, liquid-staking contracts and lockups; sub-1,000 NEAR delegations are folded per pool and class.",
                  "sources": [
                    "fastnear-rpc-staking-pool-views",
                    "fastnear-rpc-liquid-staking"
                  ]
                },
                {
                  "primitive": "colour",
                  "why": "Whether a pool is named or anonymous; names come from self-declared pool-details.near entries or named account ids.",
                  "sources": [
                    "nearblocks-validators",
                    "account-id"
                  ]
                },
                {
                  "primitive": "outline",
                  "why": "Solid for self-declared or verified names, dashed for inferred, none when unknown.",
                  "sources": [
                    "nearblocks-validators",
                    "account-id"
                  ]
                },
                {
                  "primitive": "order",
                  "why": "Largest stake first, clockwise from the top.",
                  "sources": [
                    "fastnear-rpc-validators"
                  ]
                }
              ],
              "conflicts": [
                "Validator stake is also shaped by protocol seat rules, kickouts and produced-block performance; this flower draws only delegated stake and who backs it, not uptime or governance influence."
              ],
              "unknowns": [
                "Liquid-staking contract delegations (Meta Pool, LiNEAR and others) are shown as one backer segment; their own token holders are not resolved.",
                "Lockup contracts are marked as lockups, but their owners are not resolved.",
                "The 424 idle pools (no seat, no proposal) were not crawled, so their delegators are missing from the backer split.",
                "Addresses are not people: a delegator account may be a contract, an exchange or a custodian.",
                "Pool names are self-declared in pool-details.near and are not verified identity."
              ],
              "inferred": [
                "Grouping a delegation as liquid-staking, lockup or 1M+ backer relies on account type and balance heuristics, not on a declared ownership proof."
              ],
              "documents": []
            }
          }
        }
